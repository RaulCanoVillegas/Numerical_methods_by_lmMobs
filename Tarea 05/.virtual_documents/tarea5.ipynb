            if metodo in NUEVOS:
                filas_min.append([f"\\texttt{{{nombre}}}", metodo, 'falla', '---', '---', 'No'])
            continue
        xk, orb = res
        gn = np.linalg.norm(gradF[nombre](xk))
        print(f"{nombre:<11}{metodo:<8}{str(xk):<34}{len(orb):>5}"
