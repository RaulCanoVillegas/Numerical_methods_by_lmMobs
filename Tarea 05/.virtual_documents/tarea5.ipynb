            filas_min.append([f"\\texttt{{{nombre}}}", metodo,
                              "$(" + num(xk[0]) + ",\\,"  + num(xk[1]) + ")$", str(len(orb)), sci(gn),
                              'Sí' if acierta(nombre, xk) else 'No'])
    print()

